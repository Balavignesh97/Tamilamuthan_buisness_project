<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dharmacorpus.Web</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Set to true to skip the npm build (e.g. when site.css is already built). -->
    <SkipClientBuild Condition="'$(SkipClientBuild)' == ''">false</SkipClientBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Site content (practice areas, team, FAQs) ships with the app. -->
    <Content Update="Content\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Front-end sources are not part of the published output. -->
    <Content Remove="package.json;package-lock.json" />
    <None Remove="node_modules\**" />
    <Content Remove="node_modules\**" />
  </ItemGroup>

  <!-- Builds Tailwind CSS and copies jQuery, Flowbite and fonts into wwwroot. -->
  <Target Name="ClientBuild" BeforeTargets="BeforeBuild" Condition="'$(SkipClientBuild)' != 'true'">
    <Exec Command="npm ci --no-audit --no-fund" Condition="!Exists('node_modules')" />
    <Exec Command="npm run build" />
  </Target>

</Project>
