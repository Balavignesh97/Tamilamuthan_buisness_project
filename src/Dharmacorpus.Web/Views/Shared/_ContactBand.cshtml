@inject ContentService Content
@{ var site = Content.Site; }
<section class="pb-20 pt-4 sm:pb-24" aria-labelledby="contactBandTitle">
    <div class="container-site">
        <div class="grid items-center gap-10 rounded-2xl bg-navy p-8 text-navy-tint sm:p-14 lg:grid-cols-2">
            <div class="space-y-4">
                <h2 id="contactBandTitle" class="text-[30px] font-semibold leading-tight text-white sm:text-4xl">Need legal assistance?</h2>
                <p class="text-[17px] leading-relaxed">Tell us briefly about your matter. We will confirm the appropriate next step and whether we can assist.</p>
                <p class="text-[13px] text-panel-muted">Contacting the office does not by itself create an advocate–client relationship.</p>
            </div>
            <div class="flex flex-col gap-3">
                <a href="tel:@site.Phone" class="btn-light !justify-start">@Html.Icon("phone") @site.PhoneDisplay</a>
                <a href="mailto:@site.Email" class="btn-light !justify-start">@Html.Icon("mail") @site.Email</a>
                <a href="/contact" class="btn-ghost-light !justify-start">@Html.Icon("message") Send an enquiry online</a>
            </div>
        </div>
    </div>
</section>
