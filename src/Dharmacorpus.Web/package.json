{
  "name": "dharmacorpus-web",
  "version": "1.0.0",
  "description": "Front-end build for the Dharmacorpus website (Tailwind CSS, Flowbite, jQuery)",
  "scripts": {
    "build:css": "tailwindcss -i ./Styles/app.css -o ./wwwroot/css/site.css --minify",
    "copy:vendor": "node ./build/copy-vendor.mjs",
    "build": "npm run copy:vendor && npm run build:css",
    "watch:css": "tailwindcss -i ./Styles/app.css -o ./wwwroot/css/site.css --watch"
  },
  "devDependencies": {
    "@fontsource/lato": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "flowbite": "^3.1.2",
    "jquery": "^3.7.1",
    "tailwindcss": "^4.3.3"
  },
  "private": true
}
